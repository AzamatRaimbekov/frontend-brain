{
  "name": "ds-configurator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design-system site: projects with shadcn tokens (Mbank base + overrides + custom tokens), API for the Figma widget, outputs tokens.css / shadcn registry:base / figma.json; plus the fork of the shadcn/ui /create generator",
  "license": "MIT",
  "scripts": {
    "prebuild": "node scripts/prebuild.mjs",
    "predev": "node scripts/prebuild.mjs",
    "pretest": "node scripts/prebuild.mjs",
    "pretypecheck": "node scripts/prebuild.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && vite build --ssr server/main.ts --outDir dist-server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist-server/main.js",
    "serve": "npm run build && npm start",
    "dev:server": "vite-node server/main.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
