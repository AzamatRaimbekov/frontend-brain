{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "singleAttributePerLine": true,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports"
  ],
  "importOrder": [
    "^react$",
    "^react(.*)$",
    "^(react-dom)/(.*)$",
    "<THIRD_PARTY_MODULES>",
    "^(@/)?(app)/(.*)$",
    "^(@/)?(routes)/(.*)$",
    "^(@/)?(modules)/(.*)$",
    "^(@/)?shared/ui(.*)$",
    "^(@/)?shared/hooks(.*)$",
    "^(@/)?shared/icons(.*)$",
    "^(@/)?shared/config(.*)$",
    "^../",
    "^./",
    ".(s)*css$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "endOfLine": "lf"
}
