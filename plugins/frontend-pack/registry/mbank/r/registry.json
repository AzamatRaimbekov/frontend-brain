  "items": [
    {
      "name": "mbank",
      "type": "registry:base",
      "title": "Mbank design system",
      "description": "Design tokens: the standard shadcn/ui set (light/dark, radius scale, font), @theme inline mapping (Tailwind v4), nothing custom. Generated from tokens.css (shadcn-tokens.json).",
      "dependencies": [
        "tw-animate-css",
        "class-variance-authority",
        "clsx",
        "tailwind-merge",
        "radix-ui"
