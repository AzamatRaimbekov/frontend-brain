{
 "$comment": "CSS var -> Figma source for tokens.css, built by scripts/tokens-build.mjs with figma-pack mbank-figma-patterns/references/tokens.json. Token: figma = variable name in collection (default theme = 2.theme: light value in :root, dark in .dark); value = literal; light/dark = false (not emitted) or an override {value | figma, collection, mode, gap, note}. Every override that departs from Figma names its gap from figma-pack mbank-design-system/references/gaps.md. Group: comment, darkComment, compact (true or N per line), utilities:false (no --color-*), dark:false. ignore = Figma names (prefix, or glob with *) not reported as unused: Tailwind built-ins (rounded-none/full, shadow-none) and font-weight variants (-md/-strong).",
 "collections": {
  "theme": "2.theme (Foundation), modes light | dark",
  "brand": "1.brand (Foundation), modes bank | kassa | travel | artwin | koko",
  "brandRadius": "1.brand radius/* (web radius scale, one value)",
  "webSpacing": "Web components spacing/* (aliases of rem/default/*)",
  "textStyles.web": "Web components text styles font/*",
  "effectStyles.web": "Web components effect styles shadow/*"
 },
 "header": [
  "Mbank design tokens for Tailwind CSS v4 + shadcn/ui.",
  "GENERATED by frontend-pack scripts/tokens-build.mjs from figma-pack mbank-figma-patterns/references/tokens.json",
  "and registry/mbank/tokens.map.json. Do not edit by hand: change Figma (read-tokens.js) or the map, then run",
  "node plugins/frontend-pack/scripts/tokens-build.mjs. Values are Figma hex, unchanged; overrides are marked TODO(Gxx).",
  "",
  "Usage (src/index.css or src/app/globals.css):",
  "  @import \"tailwindcss\";",
  "  @import \"tw-animate-css\";",
  "  @import \"./styles/mbank-tokens.css\";",
  "",
  "Theme: light on :root, dark on .dark (class on <html>).",
  "Product brand: <html data-brand=\"bank|kassa|travel|artwin|koko\"> (default bank). Only --brand* change.",
  "Font: Inter Mbank is not distributed yet (gap G03). Self-host the woff2 files when the brand team",
  "supplies them; until then the stack falls back to Inter / system-ui."
 ],
 "preamble": ["@custom-variant dark (&:where(.dark, .dark *));"],
