{
  "$schema": "mbank/component@1",
  "name": "badge",
  "title": "Badge",
  "figma": {
    "name": "Badge-status",
    "key": "f25dcf8a0cdeb0a978f91b7a07790d42b80f9dcd",
    "nodeId": "2348:2631"
  },
  "parts": [
    "root",
    "icon",
    "label"
  ],
  "props": {
    "tone": {
      "values": [
        "neutral",
        "accent",
        "success",
        "warning",
        "info",
        "error",
        "clear"
      ],
      "default": "neutral"
    },
    "shape": {
      "values": [
        "rounded",
        "square"
      ],
      "default": "rounded"
    },
    "size": {
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md"
    }
  },
  "base": {
    "root": {
      "gap": 1,
      "weight": "medium",
      "align": "center"
    },
    "icon": {
      "size": 3,
      "hidden": true
    }
  },
  "variants": {
    "tone": {
      "neutral": {
        "root": {
          "bg": "accent",
          "fg": "accent-foreground"
        }
      },
      "accent": {
        "root": {
          "bg": "primary",
          "fg": "primary-foreground"
        }
      },
      "success": {
        "root": {
          "bg": "success/10",
          "fg": "success"
        }
      },
      "warning": {
        "root": {
          "bg": "warning/10",
          "fg": "warning"
        }
      },
      "info": {
        "root": {
          "bg": "info/10",
          "fg": "info"
        }
      },
      "error": {
        "root": {
          "bg": "destructive/10",
          "fg": "destructive"
        }
      },
      "clear": {
        "root": {
          "border-width": 1,
          "border": "border",
          "fg": "foreground"
        }
      }
    },
    "shape": {
      "rounded": {
        "root": {
          "radius": "full"
        }
      },
      "square": {
        "root": {
          "radius": "sm"
        }
      }
    },
    "size": {
      "sm": {
        "root": {
          "height": 5,
          "px": 1.5,
          "text": "xs"
        }
      },
      "md": {
        "root": {
          "height": 6,
          "px": 2,
          "text": "xs"
        }
      },
      "lg": {
        "root": {
          "height": 7,
          "px": 2.5,
          "text": "sm"
        }
      }
    }
  },
  "states": [
    "default"
  ],
  "code": {
    "file": "badge.tsx",
    "export": "badgeVariants",
    "template": "badge-like",
    "parts": {
      "icon": "[&>svg]"
    },
    "extra": "inline-flex w-fit shrink-0 justify-center overflow-hidden whitespace-nowrap [&>svg]:pointer-events-none",
    "figmaOnly": [
      "label"
    ]
  }
}
