{
  "$schema": "mbank/component@1",
  "name": "progress",
  "title": "Progress",
  "figma": {
    "name": "Progress bar / Determinate",
    "key": "cf47478133f9b8625225affab7ae57b7b022c9bd",
    "nodeId": "4823:334"
  },
  "parts": [
    "root",
    "indicator"
  ],
  "anatomy": {
    "root": {
      "width": 240
    },
    "indicator": {
      "width": 144
    }
  },
  "props": {
    "size": {
      "values": [
        "sm",
        "md",
        "lg"
      ],
