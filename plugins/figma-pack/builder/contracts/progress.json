        }
      },
      "md": {
        "root": {
          "height": 2
        }
      },
      "lg": {
        "root": {
          "height": 3
        }
      }
    },
    "shape": {
      "rounded": {
        "root": {
          "radius": "full"
        },
        "indicator": {
          "radius": "full"
        }
      },
      "square": {
        "root": {
          "radius": "none"
        },
        "indicator": {
          "radius": "none"
        }
      }
    }
  },
  "states": [
    "default"
  ],
  "code": {
    "file": "progress.tsx",
    "export": "progressVariants",
    "template": "card-like",
    "extra": "relative w-full overflow-hidden",
