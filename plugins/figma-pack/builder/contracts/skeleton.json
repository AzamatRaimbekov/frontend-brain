{
  "$schema": "mbank/component@1",
  "name": "skeleton",
  "title": "Skeleton",
  "parts": [
    "root"
  ],
  "anatomy": {
    "root": {
      "width": 240
    }
  },
  "props": {
    "shape": {
      "values": [
        "line",
        "circle",
        "block"
      ],
      "default": "line"
    }
  },
  "base": {
    "root": {
      "radius": "md",
      "bg": "surface-2"
    }
  },
  "variants": {
    "shape": {
      "line": {
        "root": {
          "height": 4,
          "radius": "sm"
        }
      },
      "circle": {
        "root": {
          "size": 10,
          "radius": "full"
        }
      },
      "block": {
        "root": {
          "height": 24,
          "radius": "lg"
        }
      }
    }
  },
  "states": [
    "default"
  ],
  "code": {
    "file": "skeleton.tsx",
    "shape": "classes",
    "template": "card-like",
    "extra": "animate-pulse motion-reduce:animate-none"
  }
}
