{
  "$schema": "mbank/component@1",
  "name": "card",
  "title": "Card",
  "parts": [
    "root",
    "header",
    "title",
    "description",
    "content",
    "body",
    "footer",
    "action"
  ],
  "anatomy": {
    "root": {
      "width": 320
    },
    "header": {
      "fill": true
    },
    "title": {
      "parent": "header",
      "sample": "Заголовок карточки"
    },
    "description": {
      "parent": "header",
      "sample": "Короткое описание содержимого"
    },
    "content": {
      "fill": true
    },
    "footer": {
      "fill": true
    },
    "body": {
      "parent": "content",
      "kind": "text",
      "sample": "Здесь содержимое карточки: текст, список или таблица.",
      "fill": true
    },
    "action": {
      "parent": "footer",
      "kind": "instance",
      "component": {
        "name": "Button"
      },
      "sample": "Подробнее"
    }
  },
  "props": {},
  "base": {
    "root": {
      "gap": 4,
      "radius": "lg",
      "border-width": 1,
      "border": "border",
      "bg": "card",
      "py": 5,
      "fg": "card-foreground",
      "layout": "column"
    },
    "header": {
      "gap": 1,
      "px": 5,
      "align": "start",
      "layout": "column"
    },
    "title": {
      "text": "base",
      "weight": "bold"
    },
    "description": {
      "text": "sm",
      "fg": "muted-foreground"
    },
    "content": {
      "px": 5,
      "layout": "column"
    },
    "footer": {
      "gap": 2,
      "px": 5,
      "layout": "row",
      "align": "start"
    },
    "body": {
      "text": "sm",
      "fg": "muted-foreground"
    }
  },
  "variants": {},
  "states": [
    "default"
  ],
  "code": {
    "file": "card.tsx",
    "shape": "classes",
    "template": "card-like",
    "blocks": [
      "header",
      "title",
      "description",
      "content",
      "footer"
    ],
    "extras": {
      "header": "grid auto-rows-min grid-rows-[auto_auto] has-data-[slot=card-action]:grid-cols-[1fr_auto]",
      "footer": "[.border-t]:pt-4"
    }
  }
}
