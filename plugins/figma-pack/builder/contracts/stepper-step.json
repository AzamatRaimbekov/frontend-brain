    },
    "description": {
      "text": "caption",
      "fg": "muted-foreground"
    }
  },
  "variants": {
    "status": {
      "done": {
        "marker": {
          "bg": "status-success-muted"
        },
        "number": {
          "fg": "status-success"
        }
      },
      "current": {
        "root": {
